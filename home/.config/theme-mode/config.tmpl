# Rendered by homie. Read by ~/.local/bin/theme-mode, which turns it into the
# mode state file that .zshrc, nvim, tmux and starship all key off.
#
# "light" / "dark" pin the host. "auto" follows the desktop's own setting via
# the XDG desktop portal — see scripts/23-theme-mode.sh for the watcher.
THEME={{ .Vars.THEME }}
