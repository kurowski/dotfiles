[init]
	defaultBranch = main

[pull]
	rebase = false

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[include]
	path = ~/.gitconfig.catppuccin-delta

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	features = {{ if eq .Vars.THEME "dark" }}catppuccin-mocha{{ else }}catppuccin-latte{{ end }}

[merge]
	conflictStyle = zdiff3
