[Unit]
Description=rclone backup: seafile (seafile: -> b2:brattlebowl-winston-seafile)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=brandt
Environment=HOME=/home/brandt
ExecStart=/usr/bin/rclone sync seafile: b2:brattlebowl-winston-seafile --transfers 8 --stats 1m --stats-log-level NOTICE
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
