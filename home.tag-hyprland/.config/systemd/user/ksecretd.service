[Unit]
Description=KWallet Secret Service (org.freedesktop.secrets) for the Hyprland session
Documentation=https://invent.kde.org/frameworks/kwallet

# Why this unit exists at all.
#
# Anything that stores a credential on Linux — 1Password's unlocked session,
# Electron apps like Claude Desktop, anything using libsecret — asks D-Bus for
# org.freedesktop.secrets. Under Plasma, ksecretd provides it and Plasma starts
# ksecretd. Nothing starts it under Hyprland.
#
# It is not fixable by D-Bus activation either, which is the non-obvious part:
# /usr/share/dbus-1/services/org.kde.secretservicecompat.service registers
# ksecretd under its *KDE* name only. `org.freedesktop.secrets` is a name
# ksecretd claims at runtime once running, and no activation file anywhere
# declares it — so a client asking for it gets "no such name" rather than
# starting the daemon. The symptom is an app reporting no system keyring, or
# 1Password saying it could not save the session after 2FA.
#
# Deliberately scoped to the Hyprland session rather than graphical-session:
# under Plasma, Plasma is already starting its own copy, and a second one would
# just lose the race for the bus name.
#
# The wallet itself is unlocked at login by pam_kwallet5.so, which /etc/pam.d/
# sddm already invokes — despite the filename, that module ships in kwallet-pam
# 6.x and is current. So this only needs to start the daemon, not authenticate.
After=wayland-session-waitenv.service
PartOf=wayland-session@hyprland.desktop.target
After=wayland-session@hyprland.desktop.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/ksecretd
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=wayland-session@hyprland.desktop.target
