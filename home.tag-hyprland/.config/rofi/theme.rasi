/* Rofi appearance.
 *
 * Every colour is a variable from flavor-latte.rasi / flavor-mocha.rasi, which
 * theme-mode concatenates in front of this file. Nothing here names a colour,
 * so a theme flip is a re-concatenate and nothing else.
 *
 * Sized for a 1536x960 logical desktop: a centred panel at 38% width, which is
 * wide enough for application names without becoming a second window. */

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            38%;
    border-radius:    14px;
    background-color: var(windowBg);
    /* A hairline in the accent, not a heavy frame — it echoes the active
     * window border without competing with it. */
    border:           2px;
    border-color:     var(accent);
    padding:          0;
    children:         [ mainbox ];
}

mainbox {
    background-color: transparent;
    padding:          14px;
    spacing:          12px;
    children:         [ inputbar, message, listview ];
}

/* ── input ──────────────────────────────────────────────────────────────── */

inputbar {
    background-color: var(surface0);
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       var(accent);
    font:             "JetBrainsMono Nerd Font Bold 11";
    vertical-align:   0.5;
}

entry {
    background-color:      transparent;
    text-color:            var(text);
    placeholder:           "search";
    placeholder-color:     var(overlay0);
    cursor:                text;
    vertical-align:        0.5;
}

/* ── results ────────────────────────────────────────────────────────────── */

listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    /* Keep the panel a constant height rather than growing and shrinking as
     * the result count changes — a launcher that resizes under your typing is
     * hard to aim at. */
    fixed-height:     true;
    cycle:            true;
    dynamic:          false;
    scrollbar:        false;
    spacing:          2px;
}

element {
    background-color: transparent;
    text-color:       var(subtext1);
    border-radius:    9px;
    padding:          9px 12px;
    spacing:          12px;
    children:         [ element-icon, element-text ];
}

element-icon {
    size:             22px;
    background-color: transparent;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

element normal.normal {
    text-color: var(subtext1);
}

element alternate.normal {
    text-color: var(subtext1);
}

/* The selected row is the only filled surface in the list. */
element selected.normal {
    background-color: var(accent);
    text-color:       var(onAccent);
}

element selected.active,
element selected.urgent {
    background-color: var(accent);
    text-color:       var(onAccent);
}

element normal.active {
    text-color: var(green);
}

element normal.urgent {
    text-color: var(red);
}

/* ── message (used by -dmenu prompts) ───────────────────────────────────── */

message {
    background-color: var(surface0);
    border-radius:    10px;
    padding:          8px 12px;
}

textbox {
    background-color: transparent;
    text-color:       var(subtext0);
    vertical-align:   0.5;
}
